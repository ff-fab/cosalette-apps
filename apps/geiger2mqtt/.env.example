# geiger2mqtt environment configuration
#
# Copy this file to .env and adjust values for your deployment. .env is
# gitignored; only this .example file (with placeholder values) is committed.

# --- Container ---
# Numeric GID of the host's gpio group (the image has no gpio group by name).
# It differs between installs: check with `getent group gpio`.
GEIGER2MQTT_GPIO_GID=997

# --- Geiger counter ---
# BCM number of the GPIO pin wired to the board output
GEIGER2MQTT_GPIO_PIN=4
GEIGER2MQTT_GPIO_CHIP=/dev/gpiochip0
# Leave off when the board drives the line itself
GEIGER2MQTT_GPIO_PULL_UP=false
# µSv/h per CPM; 0.0057 suits an SBM-20 tube (see docs/configuration.md)
GEIGER2MQTT_CONVERSION_FACTOR=0.0057
# Seconds covered by the average dose rate
GEIGER2MQTT_AVERAGE_WINDOW=900
GEIGER2MQTT_PUBLISH_INTERVAL=30
# Seconds without a pulse before the sensor goes offline; 0 disables the check
GEIGER2MQTT_NO_PULSE_TIMEOUT=300

# --- MQTT broker connection ---
GEIGER2MQTT_MQTT__HOST=localhost
GEIGER2MQTT_MQTT__PORT=1883
# GEIGER2MQTT_MQTT__USERNAME=
# GEIGER2MQTT_MQTT__PASSWORD=
GEIGER2MQTT_MQTT__TOPIC_PREFIX=geiger2mqtt

# TLS (disabled by default — set to true and configure the paths below
# together to enable broker TLS on port 8883)
GEIGER2MQTT_MQTT__TLS=false
# GEIGER2MQTT_MQTT__TLS_CA_FILE=
# GEIGER2MQTT_MQTT__TLS_CERT_FILE=
# GEIGER2MQTT_MQTT__TLS_KEY_FILE=

# MQTT 5 retained-message expiry (docs/configuration.md). Set to 3.1.1 for a
# broker without MQTT 5.
GEIGER2MQTT_MQTT__PROTOCOL_VERSION=5
# GEIGER2MQTT_MQTT__MESSAGE_EXPIRY_INTERVAL=86400

# --- Logging ---
GEIGER2MQTT_LOGGING__LEVEL=INFO
GEIGER2MQTT_LOGGING__FORMAT=json
