# Canonical settings profile for `task jeelink2mqtt:schema:generate` (cap-ayy, ADR-051).
#
# NOT used at runtime and contains NO real secrets. It exists solely so
# `cosalette schema dump --resolve-settings` can run the configure/expand
# lifecycle and turn the 'sensor_entity' handler's callable name= NameSpec
# (keyed off settings.sensors) into real per-sensor channels (e.g.
# officeState/outdoorState) instead of the generic sensor_entityState
# placeholder. Sensor names are illustrative only — they do not need to
# match any real deployment.
JEELINK2MQTT_SENSORS=[{"name":"office","temp_offset":0.0,"humidity_offset":0.0},{"name":"outdoor","temp_offset":0.0,"humidity_offset":0.0}]
