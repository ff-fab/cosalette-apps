# Canonical settings profile for `task caldates2mqtt:schema:generate` (cap-0cg, ADR-051).
#
# NOT used at runtime and contains NO real secrets. It exists solely so
# `cosalette schema dump --resolve-settings` can run the configure/expand
# lifecycle and turn the 'calendar' handler's callable name= NameSpec
# (_calendar_map, keyed off settings.calendars) into real per-calendar
# channels (e.g. birthdayState/garbageState) instead of the generic
# calendarState placeholder. URL/username/password are dummy placeholders —
# they do not need to match any real deployment.
CALDATES2MQTT_CALENDARS=[{"key":"birthday","url":"https://example.invalid/caldav/birthday","calendar_name":"Birthdays","username":"schema-gen","password":"schema-gen"},{"key":"garbage","url":"https://example.invalid/caldav/garbage","calendar_name":"Garbage","username":"schema-gen","password":"schema-gen"}]
