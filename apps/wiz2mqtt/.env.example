# wiz2mqtt environment configuration
#
# Copy this file to .env and adjust values for your deployment. .env is
# gitignored; only this .example file (with placeholder values) is committed.
#
# Bulb inventory settings (cap-10u.9) will extend this file once landed.

# --- MQTT broker connection ---
WIZ2MQTT_MQTT__HOST=localhost
WIZ2MQTT_MQTT__PORT=1883
# WIZ2MQTT_MQTT__USERNAME=
# WIZ2MQTT_MQTT__PASSWORD=
WIZ2MQTT_MQTT__TOPIC_PREFIX=wiz2mqtt

# TLS (disabled by default — set to true and configure the paths below
# together to enable broker TLS on port 8883)
WIZ2MQTT_MQTT__TLS=false
# WIZ2MQTT_MQTT__TLS_CA_FILE=
# WIZ2MQTT_MQTT__TLS_CERT_FILE=
# WIZ2MQTT_MQTT__TLS_KEY_FILE=

# --- Logging ---
WIZ2MQTT_LOGGING__LEVEL=INFO
WIZ2MQTT_LOGGING__FORMAT=json
